# Copy to .env and fill in your values:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
#
# Priority for every variable below: CLI flag > this file > default.
# See docs/en/local-run.md (or docs/ru/local-run.md) for the full reference.

# Shop base URL, no trailing slash (required; no working default).
BASE_URL=https://shop.example.com

# chrome | firefox (default: chrome). CLI override: --browser
BROWSER=chrome

# true | false — run without a visible window (default: true). CLI: --headed / --headless
HEADLESS=true

# true | false — write logs/test-run.log (default: false). CLI: --local-log / --no-local-log
LOCAL_LOG=false

# Log file level when LOCAL_LOG=true: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO
